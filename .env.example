# =====================================================================
# .env.example - seznam promennych prostredi, kterymi jde aplikaci nastavit
# (tento soubor je v gitu jen jako vzor, NEPISTE do nej skutecne hodnoty)
#
# Pouziti:
#   - Render: hodnoty se zadavaji v Dashboard -> sluzba -> Environment
#             (vetsinu predvyplni render.yaml),
#   - Docker lokalne: zkopiruj tento soubor jako .env (je v .gitignore)
#             a vypln ANTHROPIC_API_KEY; docker compose si ho nacte sam,
#   - XAMPP: misto promennych se pouziva config.php.
# Promenna prostredi ma prednost pred config.php.
# =====================================================================

# --- AI ---
# Groq - ZDARMA: klic z https://console.groq.com/keys (zacina gsk_)
GROQ_API_KEY=
# Nepovinne: placeny Claude - klic z https://platform.claude.com -> API Keys (zacina sk-ant-)
ANTHROPIC_API_KEY=
# auto = prednost ma Groq, kdyz je jeho klic vyplneny; jinak groq / claude
AI_POSKYTOVATEL=auto
# Model (prazdne = vychozi: Groq openai/gpt-oss-120b, Claude claude-haiku-5-5)
AI_MODEL=
# Narocnost premysleni (low = nejmene tokenu)
AI_EFFORT=low
# Ochrana kreditu: generovani za hodinu na uzivatele / za 24 hodin pro vsechny
AI_LIMIT_ZA_HODINU=20
AI_LIMIT_ZA_DEN=200

# --- Databaze MySQL (na Renderu: udaje z Aiven -> Connection information) ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=defaultdb
# 1 = sifrovane spojeni (cloudova databaze to vyzaduje)
DB_SSL=1
# Certifikat autority databaze (cely text vcetne -----BEGIN CERTIFICATE-----)
DB_SSL_CA=

# --- Ostatni ---
# 1 = aplikace bezi za proxy hostingu (Render) - spravne pozna HTTPS a IP navstevnika
DUVERYHODNA_PROXY=1
# 0 = nove ucty nejdou zalozit
REGISTRACE_POVOLENA=1
